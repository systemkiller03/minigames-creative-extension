NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://minigames:minigames@localhost:5433/minigames
REDIS_URL=redis://localhost:6379
# Reverse proxies in front of the API (CloudFront + load balancer = 2, a single Caddy = 1).
# Too high lets clients forge their IP and bypass rate limits.
# TRUST_PROXY_HOPS=2
UPSTREAM_BASE_URL=https://your-upstream-host
# UPSTREAM_TIMEOUT_MS=5000
# Users are sent upstream as u-{user id}@this domain, never with their real email.
# UPSTREAM_EMAIL_DOMAIN=minigames-gateway.invalid
# Two different random secrets, at least 32 characters each (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:5173,https://your-cloudfront-domain
# Optional Google OAuth; configure all four values to enable Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@minigames.local
# Set SMTP_USER and SMTP_PASSWORD together for authenticated SMTP providers.
# SMTP_USER=
# SMTP_PASSWORD=